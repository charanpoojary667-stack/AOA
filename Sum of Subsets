#include <stdio.h>
int a[20], s[20], n, target;
void subset(int i, int sum, int c) {
   if(sum==target) {
       printf("Subset: { ");
       for(int j=0;j<c;j++) printf("%d ",s[j]);
       printf("}\n");
       return;
   }
   if(i==n || sum>target) return;

    s[c]=a[i];
    subset(i+1,sum+a[i],c+1);
    subset(i+1,sum,c);
}
int main() {
   printf("Enter number of elements: ");
   scanf("%d",&n);
   printf("Enter elements: ");
   for(int i=0;i<n;i++) scanf("%d",&a[i]);
    printf("Enter target sum: ");
    scanf("%d",&target);
    subset(0,0,0);
    return 0;
}
