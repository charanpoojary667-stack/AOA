#include <stdio.h>
#include <string.h>
#define Q 101
int main() {
   char t[100], p[50];
   int n, m, i, j, h=1, x=0, y=0, f=0;
   printf("Enter text: ");
   scanf("%99s", t);
   printf("Enter pattern: ");
   scanf("%49s", p);
   n=strlen(t);
   m=strlen(p);
   if(m>n) {
      printf("Pattern not found\n");
      return 0;
   }
   for(i=0;i<m-1;i++)
      h=(h*256)%Q;

    for(i=0;i<m;i++) {
       x=(256*x+p[i])%Q;
       y=(256*y+t[i])%Q;
    }
    for(i=0;i<=n-m;i++) {
       if(x==y) {
           for(j=0;j<m;j++)
               if(t[i+j]!=p[j]) break;
           if(j==m) {
               printf("Pattern found at index %d\n",i);
               f=1;
         }
      }
      if(i<n-m) {
          y=(256*(y-t[i]*h)+t[i+m])%Q;
          if(y<0) y+=Q;
      }
    }
    if(!f) printf("Pattern not found\n");
    return 0;
}
