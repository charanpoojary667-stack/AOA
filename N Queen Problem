#include <stdio.h>
int b[20], n;
int safe(int r, int c) {
   for(int i=1;i<r;i++)
       if(b[i]==c || b[i]-i==c-r || b[i]+i==c+r)
           return 0;
   return 1;
}
void solve(int r) {
   if(r>n) {
       printf("[");
       for(int i=1;i<=n;i++)
           printf("%d%s",b[i],i<n?", ":"");
       printf("]\n");
       return;
   }
   for(int c=1;c<=n;c++)
       if(safe(r,c)) {
           b[r]=c;
           solve(r+1);
       }
}
int main() {
   printf("Enter the value of n: ");
   scanf("%d",&n);
   printf("Solutions for %d-Queen problem:\n",n);
   solve(1);
    return 0;
}
