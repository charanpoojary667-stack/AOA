#include <stdio.h>
#define INF 999
int main() {
   int n, g[10][10], s[10]={0}, i, j, e=0, total=0, min, x, y;
   printf("Enter number of vertices: ");
   scanf("%d", &n);
   printf("Enter cost between each pair of vertices:\n");
   for(i=0;i<n;i++)
      for(j=i+1;j<n;j++) {
         printf("Cost of edge %d-%d: ",i+1,j+1);
         scanf("%d",&g[i][j]);
         g[j][i]=g[i][j];
      }
   s[0]=1;
   printf("\nEdges in Minimum Spanning Tree:\n");
   while(e<n-1) {
      min=INF;
      for(i=0;i<n;i++)
         for(j=0;j<n;j++)
            if(s[i] && !s[j] && g[i][j]>0 && g[i][j]<min)
                min=g[i][j], x=i, y=j;
      printf("%d - %d = %d\n",x+1,y+1,min);
      total+=min; s[y]=1; e++;
    }
    printf("Minimum Cost = %d\n",total);
    return 0;
}
