#include <stdio.h>
#define INF 999
int main() {
   int a[20][20], d[20][20], n, i, j, k;
   printf("Enter number of vertices: ");
   scanf("%d", &n);
   printf("Enter adjacency matrix (%d for INF):\n", INF);
   for(i=0;i<n;i++)
      for(j=0;j<n;j++) {
          scanf("%d",&a[i][j]);
          d[i][j] = (i==j) ? 0 : a[i][j];
      }
   printf("\nInitial Matrix:\n");
   for(k=-1;k<n;k++) {
      if(k>=0) {
          for(i=0;i<n;i++)
             for(j=0;j<n;j++)
                 if(d[i][k]!=INF && d[k][j]!=INF &&
                    d[i][k]+d[k][j]<d[i][j])
                     d[i][j]=d[i][k]+d[k][j];
          printf("\nAfter Iteration %d (Vertex %d as
Intermediate):\n",k+1,k+1);
      }
      else printf("\n");
      if(k==n-1) printf("\nFinal All Pair Shortest Path Matrix:\n");
      for(i=0;i<n;i++) {
          for(j=0;j<n;j++)
             if(d[i][j]==INF) printf("INF\t");
             else printf("%d\t",d[i][j]);
          printf("\n");
      }
      if(k==-1) printf("Initial Matrix displayed above.\n");
    }
    return 0;
}
