#include <stdio.h>
void minmax(int a[], int l, int r, int *min, int *max) {
   int m, min2, max2;
   if(l==r) {
       *min=*max=a[l];
       return;
   }
   if(l+1==r) {
       *min=a[l]<a[r]?a[l]:a[r];
       *max=a[l]>a[r]?a[l]:a[r];
       return;
   }
   m=(l+r)/2;
   minmax(a,l,m,min,max);
   minmax(a,m+1,r,&min2,&max2);
   if(min2<*min) *min=min2;
   if(max2>*max) *max=max2;
}
int main() {
   int a[100], n, min, max;
   printf("Enter number of elements: ");
   scanf("%d",&n);
    printf("Enter elements: ");
    for(int i=0;i<n;i++)
       scanf("%d",&a[i]);
    minmax(a,0,n-1,&min,&max);
    printf("Minimum = %d\nMaximum = %d\n",min,max);
    return 0;
}
